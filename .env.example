# Docker image versions — single source of truth
# Copy to .env and modify as needed: cp .env.example .env
PYTHON_VERSION=3.14.3-slim-bookworm
REDIS_VERSION=7.0.4
MARIADB_VERSION=10
NGINX_VERSION=1.27.3-alpine3.20-slim

# Database credentials
MYSQL_ROOT_PASSWORD=CHANGEME
MYSQL_PASSWORD=CHANGEME

# MTU for the compose network. Must not exceed the smallest MTU on the path to
# any scored host, or checks against hosts behind lower-MTU links will hang
# mid-handshake. Raise to 1500 only if every scored host is reachable over a
# full-MTU path.
DOCKER_NETWORK_MTU=1400
